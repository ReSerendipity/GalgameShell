# winlator 运行时大资源（构建/首次运行下载，不入库，避免仓库膨胀）
app/src/main/assets/**/*.tzst
app/src/main/assets/**/*.tar
app/src/main/assets/**/*.sf2
app/src/main/jniLibs/**/*.so

