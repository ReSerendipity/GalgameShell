diff --git a/src/libtools/libdl.c b/src/libtools/libdl.c
index fe80621..ab721bf 100644
--- a/src/libtools/libdl.c
+++ b/src/libtools/libdl.c
@@ -63,9 +63,25 @@ static void*(*real_dlopen)(const char*, int) = NULL;
 static int (*real_dlclose)(void*) = NULL;
 static void* (*real_dlsym)(void*, const char*) = NULL;
 
+
+/* Find a symbol inside libc.so.6 only. GetNativeSymbolUnversioned(RTLD_NEXT, ...)
+   iterates ALL loaded objects and can hit box64's own exported dl* wrappers
+   (exported name "dlsym" etc.), which tail-calls back into these bridges and
+    spins forever. Scoping to libc avoids the self-interposition entirely. */
+static void* find_real_in_libc(const char* name)
+{
+    eh_obj_t obj;
+    void* sym = NULL;
+    if (!eh_find_obj(&obj, "*libc.so.6")) {
+        eh_find_sym(&obj, name, &sym);
+        eh_destroy_obj(&obj);
+    }
+    return sym;
+}
+
