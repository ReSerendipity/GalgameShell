<?xml version="1.0" encoding="utf-8"?>
<!-- Swiss 游戏详情（横屏）：左封面/启动，右维护与高级 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/swiss_paper">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="20dp"
            android:paddingTop="2dp">

            <TextView
                android:id="@+id/BTBack"
                style="@style/SwissLabel"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:gravity="center_vertical"
                android:paddingEnd="12dp"
                android:text="←  返回" />

            <TextView
                android:id="@+id/TVMetaTop"
                style="@style/SwissMeta"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <ScrollView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.36"
                android:scrollbars="none"
                android:background="@color/swiss_paper">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/IVCover"
                        android:layout_width="match_parent"
                        android:layout_height="120dp"
                        android:scaleType="centerCrop"
                        android:contentDescription="@string/galgame_library_title"
                        android:src="@drawable/galgame_placeholder" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/swiss_ink" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp"
                        android:paddingTop="10dp">

                        <TextView
                            android:id="@+id/TVEyebrow"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textAllCaps="true"
                            android:textSize="8.5sp"
                            android:letterSpacing="0.18"
                            android:textColor="@color/swiss_red" />

                        <TextView
                            android:id="@+id/TVTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="24sp"
                            android:textStyle="bold"
                            android:letterSpacing="-0.03"
                            android:textColor="@color/swiss_ink" />

                        <TextView
                            android:id="@+id/TVPlayed"
                            style="@style/SwissMeta"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp" />

                        <TextView
                            android:id="@+id/TVMeta"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textAllCaps="true"
                            android:textSize="8.5sp"
                            android:letterSpacing="0.12"
                            android:textColor="@color/swiss_muted" />

                        <Button
                            android:id="@+id/BTLaunch"
                            style="@style/SwissButtonSolid"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:layout_marginTop="12dp"
                            android:text="@string/galgame_action_launch" />
                    </LinearLayout>
                </LinearLayout>
            </ScrollView>

            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="@color/swiss_ink" />

            <ScrollView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.64"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/swiss_row_line"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp"
                        android:paddingTop="6dp"
                        android:paddingBottom="4dp">

                        <TextView
                            style="@style/SwissLabel"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/galgame_section_maintain" />

                        <TextView
                            style="@style/SwissMeta"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/galgame_section_maintain_en" />
                    </LinearLayout>

                    <include layout="@layout/swiss_detail_rows" />

                    <LinearLayout
                        android:id="@+id/BTAdvanced"
                        style="@style/SwissRow"
                        android:layout_marginTop="8dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/TVAdvancedTitle"
                                style="@style/SwissRowTitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/galgame_advanced_expand" />

                            <TextView
                                style="@style/SwissRowMeta"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/galgame_advanced_meta" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/TVAdvancedAction"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="16sp"
                            android:textColor="@color/swiss_ink"
                            android:text="+" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/LLAdvanced"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <LinearLayout android:id="@+id/BTRoute" style="@style/SwissRow">
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">
                                <TextView
                                    style="@style/SwissRowTitle"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="@string/galgame_route_title" />
                                <TextView
                                    android:id="@+id/TVRouteValue"
                                    style="@style/SwissRowMeta"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content" />
                            </LinearLayout>
                            <TextView style="@style/SwissMeta" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="切换  ›" />
                        </LinearLayout>

                        <LinearLayout style="@style/SwissRow">
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">
                                <TextView
                                    style="@style/SwissRowTitle"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="@string/galgame_env_title" />
                                <TextView
                                    style="@style/SwissRowMeta"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="@string/galgame_env_meta" />
                            </LinearLayout>
                            <TextView
                                android:id="@+id/TVEnvValue"
                                style="@style/SwissMeta"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/BTReinject"
                            style="@style/SwissRow">
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">
                                <TextView
                                    style="@style/SwissRowTitle"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="@string/galgame_reinject" />
                                <TextView
                                    style="@style/SwissRowMeta"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="@string/galgame_reinject_meta" />
                            </LinearLayout>
                            <TextView style="@style/SwissMeta" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </ScrollView>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
