<?xml version="1.0" encoding="utf-8"?>
<!-- Swiss 诊断（横屏）：左汇总/操作，右检查项 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/swiss_paper">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="20dp"
        android:paddingTop="2dp">

        <TextView
            android:id="@+id/BTBack"
            style="@style/SwissLabel"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:gravity="center_vertical"
            android:paddingEnd="12dp"
            android:text="←  返回" />

        <TextView
            android:id="@+id/TVTopMeta"
            style="@style/SwissMeta"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end" />
    </LinearLayout>

    <TextView
        style="@style/SwissSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="6dp"
        android:text="@string/galgame_diag_page" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <ScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.32"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/TVSummaryNumber"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="20dp"
                    android:paddingTop="8dp"
                    android:textSize="54sp"
                    android:fontFamily="sans-serif-light"
                    android:letterSpacing="-0.05"
                    android:textColor="@color/swiss_ink" />

                <TextView
                    android:id="@+id/TVSummaryLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:textSize="12.5sp"
                    android:textStyle="bold"
                    android:textColor="@color/swiss_ink" />

                <TextView
                    android:id="@+id/TVSummaryMeta"
                    style="@style/SwissMeta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:layout_marginTop="2dp" />

                <LinearLayout android:id="@+id/BTRecheck" style="@style/SwissRow" android:layout_marginTop="10dp">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            style="@style/SwissRowTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/galgame_diag_recheck" />
                        <TextView
                            style="@style/SwissRowMeta"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/galgame_diag_recheck_meta" />
                    </LinearLayout>
                    <TextView style="@style/SwissMeta" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" />
                </LinearLayout>

                <LinearLayout android:id="@+id/BTFullLogs" style="@style/SwissRow">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            style="@style/SwissRowTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/galgame_diag_full_logs" />
                        <TextView
                            style="@style/SwissRowMeta"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/galgame_diag_full_logs_meta" />
                    </LinearLayout>
                    <TextView style="@style/SwissTag" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="LOG" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/swiss_ink" />

        <ScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.68"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/swiss_row_line"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp">

                    <TextView
                        style="@style/SwissLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/galgame_diag_checks" />

                    <TextView
                        style="@style/SwissMeta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/galgame_diag_checks_en" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/LLChecks"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</LinearLayout>
