<?xml version="1.0" encoding="utf-8"?>
<!-- Swiss 游戏库（竖屏）：报头 + 继续游玩横滑 + 全部游戏索引网格 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/swiss_paper">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- 报头 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    style="@style/SwissLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/galgame_brand_meta" />

                <ImageButton
                    android:id="@+id/BTSettings"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_galgame_settings"
                    android:tint="@color/swiss_ink"
                    android:contentDescription="@string/settings" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="bottom">

                <TextView
                    android:id="@+id/TVLibraryTitle"
                    style="@style/SwissTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/galgame_library_title" />

                <TextView
                    android:id="@+id/TVCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="40sp"
                    android:textColor="@color/swiss_count"
                    android:letterSpacing="-0.04"
                    android:fontFamily="sans-serif-light" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                style="@style/SwissMeta"
                android:text="@string/galgame_library_meta" />

            <!-- 检索行：发丝底线 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/swiss_row_line"
                android:paddingBottom="6dp">

                <EditText
                    android:id="@+id/ETSearch"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="@string/galgame_search_hint"
                    android:inputType="text"
                    android:maxLines="1"
                    android:textSize="12.5sp"
                    android:textColor="@color/swiss_ink"
                    android:textColorHint="@color/swiss_faint" />

                <TextView
                    style="@style/SwissMeta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/galgame_search_label" />
            </LinearLayout>
        </LinearLayout>

        <!-- 继续游玩 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="16dp"
            android:paddingBottom="4dp">

            <TextView
                style="@style/SwissLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/galgame_recent_title" />

            <TextView
                style="@style/SwissMeta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/galgame_recent_label" />
        </LinearLayout>

        <HorizontalScrollView
            android:id="@+id/HSVRecent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:clipToPadding="false"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <LinearLayout
                android:id="@+id/LLRecent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <!-- 全部游戏 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/swiss_row_line"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="16dp"
            android:paddingBottom="5dp">

            <TextView
                style="@style/SwissLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/galgame_all_title" />

            <TextView
                android:id="@+id/TVAllCount"
                style="@style/SwissMeta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- 分类 chips：ENGINE（自动派生）/ GENRE（预置）/ TAG（自定义），单选过滤 -->
        <HorizontalScrollView
            android:id="@+id/HSVFilter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:clipToPadding="false"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="6dp"
            android:paddingBottom="8dp">

            <LinearLayout
                android:id="@+id/LLFilterChips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical" />
        </HorizontalScrollView>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <GridView
                android:id="@+id/GVGalgames"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:numColumns="auto_fit"
                android:columnWidth="148dp"
                android:horizontalSpacing="14dp"
                android:verticalSpacing="16dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="14dp"
                android:paddingBottom="96dp"
                android:clipToPadding="false"
                android:scrollbars="none"
                android:stretchMode="columnWidth"
                android:layoutAnimation="@anim/grid_layout_animation" />

            <LinearLayout
                android:id="@+id/LEmpty"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="32dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:src="@drawable/galgame_placeholder"
                    android:contentDescription="@string/galgame_library_title" />

                <TextView
                    android:id="@+id/TVEmptyTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/galgame_empty_title"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/swiss_ink" />

                <TextView
                    android:id="@+id/TVEmptyHint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:text="@string/galgame_empty_hint"
                    android:textSize="12sp"
                    android:textColor="@color/swiss_muted" />

                <Button
                    android:id="@+id/BTImportEmpty"
                    style="@style/SwissButtonOutline"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginTop="18dp"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:text="@string/galgame_import_title" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <ImageButton
        android:id="@+id/FABImport"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:background="@drawable/swiss_fab_red"
        android:src="@android:drawable/ic_input_add"
        android:tint="@color/swiss_paper"
        android:contentDescription="@string/galgame_import_title" />

</FrameLayout>
