<?xml version="1.0" encoding="utf-8"?>
<!-- Swiss 诊断（竖屏） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/swiss_paper">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="20dp"
        android:paddingTop="6dp">

        <TextView
            android:id="@+id/BTBack"
            style="@style/SwissLabel"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:gravity="center_vertical"
            android:paddingEnd="12dp"
            android:text="←  返回" />

        <TextView
            android:id="@+id/TVTopMeta"
            style="@style/SwissMeta"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end" />
    </LinearLayout>

    <TextView
        style="@style/SwissTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="10dp"
        android:text="@string/galgame_diag_page" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="bottom"
                android:background="@drawable/swiss_row_line"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="10dp"
                android:paddingBottom="14dp">

                <TextView
                    android:id="@+id/TVSummaryNumber"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="60sp"
                    android:fontFamily="sans-serif-light"
                    android:letterSpacing="-0.05"
                    android:textColor="@color/swiss_ink" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:layout_marginBottom="6dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/TVSummaryLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/swiss_ink" />

                    <TextView
                        android:id="@+id/TVSummaryMeta"
                        style="@style/SwissMeta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/swiss_row_line"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="16dp"
                android:paddingBottom="5dp">

                <TextView
                    style="@style/SwissLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/galgame_diag_checks" />

                <TextView
                    style="@style/SwissMeta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/galgame_diag_checks_en" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/LLChecks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/swiss_row_line"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="16dp"
                android:paddingBottom="5dp">

                <TextView
                    style="@style/SwissLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/galgame_diag_actions" />

                <TextView
                    style="@style/SwissMeta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/galgame_diag_actions_en" />
            </LinearLayout>

            <LinearLayout android:id="@+id/BTRecheck" style="@style/SwissRow">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        style="@style/SwissRowTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/galgame_diag_recheck" />
                    <TextView
                        style="@style/SwissRowMeta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/galgame_diag_recheck_meta" />
                </LinearLayout>
                <TextView style="@style/SwissMeta" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" />
            </LinearLayout>

            <LinearLayout android:id="@+id/BTFullLogs" style="@style/SwissRow">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        style="@style/SwissRowTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/galgame_diag_full_logs" />
                    <TextView
                        style="@style/SwissRowMeta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/galgame_diag_full_logs_meta" />
                </LinearLayout>
                <TextView style="@style/SwissTag" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="LOG" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="24dp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
