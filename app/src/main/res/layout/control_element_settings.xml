<?xml version="1.0" encoding="utf-8"?>
<!-- 控件元素设置（Swiss）：类型 / 形状 / 缩放 / 透明度 / 区间 / 绑定 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <TextView style="@style/SwissRowMeta" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/type" />
        <Spinner style="@style/SwissSpinner" android:id="@+id/SType" android:layout_width="match_parent" android:layout_marginTop="4dp" />

        <LinearLayout
            android:id="@+id/LLShape"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView style="@style/SwissRowMeta" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/shape" />
            <Spinner style="@style/SwissSpinner" android:id="@+id/SShape" android:layout_width="match_parent" android:layout_marginTop="4dp" />
        </LinearLayout>

        <TextView style="@style/SwissRowMeta" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/scale" />
        <com.winlator.widget.SeekBar
            android:id="@+id/SBScale"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:suffix="%"
            app:step="5"
            app:minValue="50"
            app:maxValue="300" />

        <TextView style="@style/SwissRowMeta" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/opacity" />
        <com.winlator.widget.SeekBar
            android:id="@+id/SBOpacity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:suffix="%"
            app:step="5"
            app:minValue="0"
            app:maxValue="100" />

        <LinearLayout
            android:id="@+id/LLRangeOptions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView style="@style/SwissRowMeta" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/range" />
            <Spinner style="@style/SwissSpinner" android:id="@+id/SRange" android:layout_width="match_parent" android:layout_marginTop="4dp" />

            <TextView style="@style/SwissRowMeta" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/orientation" />
            <RadioGroup
                android:id="@+id/RGOrientation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <RadioButton android:id="@+id/RBHorizontal" style="@style/SwissRadio" android:text="@string/horizontal" />
                <RadioButton android:id="@+id/RBVertical" style="@style/SwissRadio" android:text="@string/vertical" />
            </RadioGroup>

            <TextView style="@style/SwissRowMeta" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/columns" />
            <com.winlator.widget.NumberPicker
                android:id="@+id/NPColumns"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:minValue="3"
                app:maxValue="8" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/LLMIDIKeyOptions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView style="@style/SwissRowMeta" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/note" />
            <Spinner style="@style/SwissSpinner" android:id="@+id/SNote" android:layout_width="match_parent" android:layout_marginTop="4dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/LLRadialMenuOptions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView style="@style/SwissRowMeta" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/bindings" />
            <com.winlator.widget.NumberPicker
                android:id="@+id/NPBindings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:minValue="3"
                app:maxValue="6" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/LLBindings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <CheckBox
            android:id="@+id/CBToggleSwitch"
            style="@style/SwissCheck"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:text="@string/toggle_switch" />

        <CheckBox
            android:id="@+id/CBMouseMoveMode"
            style="@style/SwissCheck"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:text="@string/move_mouse_when_pressed" />

        <LinearLayout
            android:id="@+id/LLCustomTextIcon"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView style="@style/SwissRowMeta" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/custom_text" />
            <EditText
                style="@style/SwissEdit"
                android:id="@+id/ETCustomText"
                android:maxLength="8"
                android:layout_width="match_parent"
                android:hint="@string/none"
                android:inputType="textCapCharacters" />

            <TextView style="@style/SwissRowMeta" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/icon" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/LLIconList"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
