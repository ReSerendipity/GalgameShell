<?xml version="1.0" encoding="utf-8"?>
<!--
  文件/快捷方式网格项：Material 竖卡（与容器/列表卡片同一视觉语言）。
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    app:cardBackgroundColor="?attr/colorSecondarySurface"
    app:cardCornerRadius="16dp"
    app:cardElevation="3dp"
    app:strokeColor="?attr/colorSecondaryVariant"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="186dp"
        android:clickable="true"
        android:focusable="true"
        android:padding="14dp"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <ImageView
            android:id="@+id/ImageView"
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="10dp" />

        <TextView
            android:id="@+id/TVTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="?attr/colorPrimaryText"
            android:textSize="15sp"
            android:textStyle="bold"
            android:ellipsize="end"
            android:maxLines="1" />

        <TextView
            android:id="@+id/TVSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:textColor="?attr/colorSecondaryText"
            android:textSize="12sp"
            android:maxLines="1" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="6dp">

            <ImageView
                style="@style/LeftSideButton"
                android:id="@+id/BTRun"
                android:layout_marginRight="2dp"
                android:src="@drawable/icon_run" />

            <ImageView
                style="@style/RightSideButton"
                android:id="@+id/BTMenu"
                android:layout_marginLeft="2dp"
                android:src="@drawable/icon_list_item_menu" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
