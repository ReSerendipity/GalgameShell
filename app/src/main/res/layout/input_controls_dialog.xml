<?xml version="1.0" encoding="utf-8"?>
<!-- 游戏内「输入控制」对话框内容（Swiss） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <Spinner
            style="@style/SwissSpinner"
            android:id="@+id/SProfile"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/BTSettings"
            style="@style/SwissIconButton"
            android:layout_marginStart="8dp"
            android:src="@drawable/icon_settings" />
    </LinearLayout>

    <CheckBox
        android:id="@+id/CBShowTouchscreenControls"
        style="@style/SwissCheck"
        android:paddingStart="0dp"
        android:paddingEnd="0dp"
        android:checked="true"
        android:text="@string/show_touchscreen_controls" />

    <CheckBox
        android:id="@+id/CBRelativeMouseMovement"
        style="@style/SwissCheck"
        android:paddingStart="0dp"
        android:paddingEnd="0dp"
        android:text="@string/relative_mouse_movement" />
</LinearLayout>
