<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- GalgameShell: 列表/网格入场 stagger 动画，复用 P6 的 galgame_layout_enter -->
    <androidx.recyclerview.widget.RecyclerView
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:id="@+id/RecyclerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scrollbars="vertical"
        app:layoutManager="LinearLayoutManager"
        android:layoutAnimation="@anim/galgame_layout_enter" />

    <TextView
        android:id="@+id/TVEmptyText"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:padding="32dp"
        android:drawableTop="@drawable/galgame_empty_state_icon"
        android:drawablePadding="18dp"
        android:lineSpacingExtra="4dp"
        android:text="@string/galgame_empty_files"
        android:textSize="15sp"
        android:textColor="?attr/colorSecondaryText"
        android:visibility="gone" />

    <!-- GalgameShell: 粘贴 FAB 品牌紫，与库页/详情页/设置页 FAB 统一 -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/BTPaste"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="right|bottom"
        android:tint="#ffffff"
        android:src="@drawable/icon_paste"
        android:layout_margin="16dp"
        app:backgroundTint="?attr/colorAccent"
        app:rippleColor="#FFFFFFFF"
        android:visibility="gone" />
</FrameLayout>
