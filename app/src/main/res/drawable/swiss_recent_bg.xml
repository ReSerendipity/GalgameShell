<?xml version="1.0" encoding="utf-8"?>
<!-- Swiss：最近游玩卡（白底 + 1dp 黑框，零圆角） -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/swiss_pressed" />
            <stroke android:width="1dp" android:color="@color/swiss_ink" />
            <corners android:radius="0dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/swiss_paper" />
            <stroke android:width="1dp" android:color="@color/swiss_ink" />
            <corners android:radius="0dp" />
        </shape>
    </item>
</selector>
