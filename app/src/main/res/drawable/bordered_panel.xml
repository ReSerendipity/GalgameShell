<?xml version="1.0" encoding="utf-8"?>
<!--
  表单分组卡背景（FieldSet / CPU 列表 / 任务管理器 / 图片选择选中态）：
  Swiss 方框——纸面 + 1dp 细线，零圆角；明暗随主题 token 反相。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="0dp" />
    <solid android:color="?attr/colorSecondarySurface" />
    <stroke android:width="1dp" android:color="?attr/colorHairline" />
</shape>
