<?xml version="1.0" encoding="utf-8"?>
<!--
  输入框背景（Swiss）：纸面 + 1dp 方框，零圆角；常态细线，聚焦/按下实黑。
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="0dp" />
            <solid android:color="@color/swiss_paper" />
            <stroke android:width="1dp" android:color="@color/swiss_ink" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="0dp" />
            <solid android:color="@color/swiss_paper" />
            <stroke android:width="1dp" android:color="@color/swiss_ink" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="0dp" />
            <solid android:color="@color/swiss_paper" />
            <stroke android:width="1dp" android:color="@color/swiss_hairline" />
        </shape>
    </item>
</selector>
