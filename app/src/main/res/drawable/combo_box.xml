<?xml version="1.0" encoding="utf-8"?>
<!--
  下拉框（ComboBox）背景：shape 替代上游 9-patch。
  常态=淡描边圆角；聚焦/按下=品牌紫描边。
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="?attr/colorSecondarySurface" />
            <stroke android:width="1.5dp" android:color="?attr/colorPrimaryVariant" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="?attr/colorSecondarySurface" />
            <stroke android:width="1.5dp" android:color="?attr/colorPrimaryVariant" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="?attr/colorSecondarySurface" />
            <stroke android:width="1dp" android:color="?attr/colorSecondaryVariant" />
        </shape>
    </item>
</selector>
