<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppThemeBase" parent="@style/Theme.AppCompat.Light.NoActionBar">
        <item name="tabSelectedTextColor">?attr/colorPrimaryText</item>
        <item name="tabTextColor">?attr/colorSecondaryText</item>
        <item name="android:windowBackground">?attr/colorPrimarySurface</item>
        <item name="android:colorBackground">?attr/colorPrimarySurface</item>
        <!-- GalgameShell：在公共祖先补 Material Components 基础属性，消除所有派生主题下 Material 控件
             （底部导航/FAB/Snackbar）inflate 时反复刷屏的 "Failed to resolve attribute colorOnSurface" 告警；
             引用既有 token，亮/深档随子主题自动继承 -->
        <item name="colorSurface">?attr/colorPrimarySurface</item>
        <item name="colorOnSurface">?attr/colorPrimaryText</item>
        <item name="android:textViewStyle">@style/TextView</item>
        <item name="android:checkboxStyle">@style/CheckBox</item>
        <item name="android:listPopupWindowStyle">@style/ListPopupWindow</item>
        <item name="listPopupWindowStyle">@style/ListPopupWindow</item>
        <item name="android:popupWindowStyle">@style/PopupWindow</item>
        <item name="popupWindowStyle">@style/PopupWindow</item>
        <item name="android:popupMenuStyle">@style/PopupMenu</item>
        <item name="popupMenuStyle">@style/PopupMenu</item>
        <item name="android:toolbarStyle">@style/Toolbar</item>
        <item name="toolbarStyle">@style/Toolbar</item>
        <item name="android:spinnerDropDownItemStyle">@style/SpinnerDropDownItem</item>
        <item name="android:navigationBarColor">#000000</item>
        <item name="android:radioButtonStyle">@style/RadioButton</item>
        <item name="radioButtonStyle">@style/RadioButton</item>
    </style>
    <style name="AppThemeLight" parent="@style/AppThemeBase">
        <item name="colorAccent">#0288d1</item>
        <item name="colorPrimary">#607d8b</item>
        <item name="colorPrimaryDark">#455a64</item>
        <item name="colorControlNormal">#e0e0e0</item>
        <item name="colorPrimaryText">#424242</item>
        <item name="colorSecondaryText">#757575</item>
        <item name="colorPrimarySurface">#fafafa</item>
        <item name="colorSecondarySurface">#ffffff</item>
        <item name="colorPrimaryVariant">#607d8b</item>
        <item name="colorSecondaryVariant">#d3dce0</item>
        <item name="colorError">#ef5350</item>
        <item name="popupMenuBackground">@drawable/content_dialog_background_light</item>
        <item name="toolboxBackground">@drawable/toolbox_light</item>
        <item name="panelBackground">@drawable/panel_background_light</item>
        <item name="preloaderBackground">@drawable/preloader_background_light</item>
        <item name="progressBarIndeterminateImage">@drawable/progress_bar_indeterminate_light</item>
    </style>
    <style name="AppThemeDark" parent="@style/AppThemeBase">
        <item name="colorAccent">#0288d1</item>
        <item name="colorPrimary">#505963</item>
        <item name="colorPrimaryDark">#3f474f</item>
        <item name="colorControlNormal">#616161</item>
        <item name="colorPrimaryText">#fafafa</item>
        <item name="colorSecondaryText">#9e9e9e</item>
        <item name="colorPrimarySurface">#1b1e21</item>
        <item name="colorSecondarySurface">#2d3238</item>
        <item name="colorPrimaryVariant">#56677a</item>
        <item name="colorSecondaryVariant">#37424f</item>
        <item name="colorError">#ef5350</item>
        <item name="popupMenuBackground">@drawable/content_dialog_background_dark</item>
        <item name="toolboxBackground">@drawable/toolbox_dark</item>
        <item name="panelBackground">@drawable/panel_background_dark</item>
        <item name="preloaderBackground">@drawable/preloader_background_dark</item>
        <item name="progressBarIndeterminateImage">@drawable/progress_bar_indeterminate_dark</item>
    </style>
    <!-- 游戏库亮色主题别名：v29 起关闭 Force Dark（系统深色模式会强转暗色） -->
    <style name="GalgameLibraryTheme" parent="@style/AppThemeLight">
        <!-- 现代过渡：界面切换淡入淡出，并启用内容转场 -->
        <item name="android:windowAnimationStyle">@style/GalgameWindowAnim</item>
        <item name="android:windowActivityTransitions">true</item>
        <!-- GalgameShell：补 Material Components 属性，消除该主题下 Material 控件 inflate 时
             "Failed to resolve attribute colorOnSurface" 的反复告警 -->
        <item name="colorSurface">#FFFFFFFF</item>
        <item name="colorOnSurface">#FF1F2430</item>
    </style>

    <style name="GalgameWindowAnim" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/fade_in</item>
        <item name="android:activityOpenExitAnimation">@anim/fade_out</item>
        <item name="android:activityCloseEnterAnimation">@anim/fade_in</item>
        <item name="android:activityCloseExitAnimation">@anim/fade_out</item>
    </style>

    <!-- 抽屉菜单项 pill 圆角形状（Material NavigationView itemShapeAppearanceOverlay） -->
    <style name="GalgameDrawerItemShape">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">14dp</item>
    </style>

    <!-- GalgameShell 外壳主题：紫色品牌（与游戏库一致）+ 亮色界面，替代上游 AppThemeDark -->
    <style name="GalgameMainTheme" parent="@style/AppThemeBase">
        <item name="colorAccent">#FF6A5AE0</item>
        <item name="colorPrimary">#FF6A5AE0</item>
        <item name="colorPrimaryDark">#FF4B3DBF</item>
        <item name="colorControlNormal">#FFC9C4EE</item>
        <item name="colorPrimaryText">#FF1F2430</item>
        <item name="colorSecondaryText">#FF6B7280</item>
        <item name="colorPrimarySurface">#FFF7F8FC</item>
        <item name="colorSecondarySurface">#FFFFFFFF</item>
        <item name="colorPrimaryVariant">#FF6A5AE0</item>
        <item name="colorSecondaryVariant">#FFE6E9F0</item>
        <item name="colorError">#FFEF5350</item>
        <item name="popupMenuBackground">@drawable/content_dialog_background_light</item>
        <item name="toolboxBackground">@drawable/toolbox_light</item>
        <item name="panelBackground">@drawable/panel_background_light</item>
        <item name="preloaderBackground">@drawable/preloader_background_light</item>
        <item name="progressBarIndeterminateImage">@drawable/progress_bar_indeterminate_light</item>
        <!-- 上游 AppThemeBase 的 android:windowBackground=?attr/colorPrimarySurface 实测解析失败（窗口退化为纯黑），
             这里用字面量颜色覆盖，确保淡紫背景真正生效 -->
        <item name="android:windowBackground">#FFF7F8FC</item>
        <item name="android:colorBackground">#FFF7F8FC</item>
        <item name="android:statusBarColor">#FF4B3DBF</item>
        <!-- GalgameShell R1 语义 token（亮档） -->
        <item name="colorSurfaceVariant">#FFF2F4FA</item>
        <item name="colorHairline">#FFEAEAF2</item>
        <item name="colorTextDisabled">#FFB6BCC8</item>
        <item name="colorOnAccent">#FFFFFFFF</item>
        <!-- GalgameShell：补 Material Components 属性（库已声明 attr，主题此前未给值），消除底部导航/FAB/Snackbar
             等控件 inflate 时反复刷屏的 "Failed to resolve attribute colorOnSurface" 告警 -->
        <item name="colorSurface">#FFFFFFFF</item>
        <item name="colorOnSurface">#FF1F2430</item>
        <item name="android:windowAnimationStyle">@style/GalgameWindowAnim</item>
    </style>

    <!-- GalgameShell 外壳深色主题：紫黑品牌色（设置里选「深色」时使用） -->
    <style name="GalgameMainThemeDark" parent="@style/AppThemeBase">
        <item name="colorAccent">#FF8B7BF0</item>
        <item name="colorPrimary">#FF32305A</item>
        <item name="colorPrimaryDark">#FF23203F</item>
        <item name="colorControlNormal">#FF5A5780</item>
        <item name="colorPrimaryText">#FFF2F3F7</item>
        <item name="colorSecondaryText">#FF9CA3AF</item>
        <item name="colorPrimarySurface">#FF17161F</item>
        <item name="colorSecondarySurface">#FF232230</item>
        <item name="colorPrimaryVariant">#FF8B7BF0</item>
        <item name="colorSecondaryVariant">#FF3A3950</item>
        <item name="colorError">#FFEF5350</item>
        <item name="popupMenuBackground">@drawable/content_dialog_background_dark</item>
        <item name="toolboxBackground">@drawable/toolbox_dark</item>
        <item name="panelBackground">@drawable/panel_background_dark</item>
        <item name="preloaderBackground">@drawable/preloader_background_dark</item>
        <item name="progressBarIndeterminateImage">@drawable/progress_bar_indeterminate_dark</item>
        <item name="android:windowBackground">#FF17161F</item>
        <item name="android:colorBackground">#FF17161F</item>
        <item name="android:statusBarColor">#FF23203F</item>
        <!-- GalgameShell R1 语义 token（深档） -->
        <item name="colorSurfaceVariant">#FF2A2938</item>
        <item name="colorHairline">#FF33324A</item>
        <item name="colorTextDisabled">#FF6B7280</item>
        <item name="colorOnAccent">#FFFFFFFF</item>
        <!-- GalgameShell：补 Material Components 属性，消除 "Failed to resolve attribute colorOnSurface" 反复告警 -->
        <item name="colorSurface">#FF232230</item>
        <item name="colorOnSurface">#FFF2F3F7</item>
        <item name="android:windowAnimationStyle">@style/GalgameWindowAnim</item>
    </style>

    <style name="AppThemeFullscreenLight" parent="@style/AppThemeLight">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:windowTranslucentNavigation">true</item>
    </style>
    <style name="AppThemeFullscreenDark" parent="@style/AppThemeDark">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:windowTranslucentNavigation">true</item>
    </style>

    <!--
      内置 Kirikiroid2 运行时的 Activity 主题。
      刻意不复用 AppThemeFullscreenDark：那条主题带 windowTranslucentStatus/Navigation，
      状态栏是"悬浮半透明"的，引擎的 GLSurfaceView 虽满屏但 UI 会被状态栏压住（上游不这么做）。
      这里对齐上游 Kirikiroid2 的 @android:style/Theme.NoTitleBar.Fullscreen：
      无标题栏 + 全屏 + 不透明黑底，与 cocos2dx GLSurfaceView 的预期一致。
    -->
    <style name="GalgameKrkrTheme" parent="@android:style/Theme.NoTitleBar.Fullscreen">
        <item name="android:windowBackground">@android:color/black</item>
    </style>
    <style name="ComboBox">
        <item name="android:layout_width">192dp</item>
        <item name="android:layout_height">42dp</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">?attr/colorPrimaryText</item>
        <item name="android:gravity">left|center_vertical</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">36dp</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:spinnerMode">dropdown</item>
        <item name="android:background">@drawable/combo_box</item>
        <item name="android:popupBackground">?attr/popupMenuBackground</item>
    </style>
    <style name="MultiSelectionComboBox">
        <item name="android:layout_width">192dp</item>
        <item name="android:layout_height">42dp</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">?attr/colorPrimaryText</item>
        <item name="android:gravity">left|center_vertical</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">36dp</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:background">@drawable/combo_box</item>
    </style>
    <style name="SpinnerDropDownItem" parent="@android:style/Widget.Holo.DropDownItem.Spinner">
        <item name="android:textColor">?attr/colorPrimaryText</item>
    </style>
    <style name="ListPopupWindow" parent="@android:style/Widget.ListPopupWindow">
        <item name="android:popupBackground">?attr/popupMenuBackground</item>
        <item name="android:dropDownHorizontalOffset">-4dp</item>
    </style>
    <style name="PopupWindow" parent="@android:style/Widget.PopupWindow">
        <item name="android:popupBackground">?attr/popupMenuBackground</item>
        <item name="android:dropDownHorizontalOffset">-4dp</item>
    </style>
    <style name="PopupMenu" parent="@android:style/Widget.PopupMenu">
        <item name="android:popupBackground">?attr/popupMenuBackground</item>
    </style>
    <style name="ContentDialog" parent="@android:style/Theme.Dialog">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
        <!-- GalgameShell：上游 ?attr/popupMenuBackground 在本主题无解析来源（背景从未生效）。
             对话框主题独立于 Activity，这里显式补齐品牌属性并按亮/深由代码选择 -->
        <item name="android:windowBackground">@drawable/galgame_dialog_bg</item>
        <item name="colorAccent">#FF6A5AE0</item>
        <item name="colorPrimaryVariant">#FF6A5AE0</item>
        <item name="colorSecondaryVariant">#FFE6E9F0</item>
        <item name="colorPrimaryText">#FF1F2430</item>
        <item name="colorSecondaryText">#FF6B7280</item>
    </style>
    <!-- GalgameShell：ContentDialog 深色档（ContentDialog 构造按 Activity 主题亮度选择） -->
    <style name="ContentDialogDark" parent="@android:style/Theme.Dialog">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowBackground">@drawable/galgame_dialog_bg_dark</item>
        <item name="colorAccent">#FF8B7BF0</item>
        <item name="colorPrimaryVariant">#FF8B7BF0</item>
        <item name="colorSecondaryVariant">#FF3A3950</item>
        <item name="colorPrimaryText">#FFF2F3F7</item>
        <item name="colorSecondaryText">#FF9CA3AF</item>
    </style>
    <style name="EditText">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">42dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">?attr/colorPrimaryText</item>
        <item name="android:textColorHint">?attr/colorSecondaryText</item>
        <item name="android:gravity">left|center_vertical</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">12dp</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:inputType">text</item>
        <item name="android:background">@drawable/edit_text</item>
    </style>
    <style name="TextView" parent="@android:style/Widget.TextView">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">?attr/colorPrimaryText</item>
    </style>
    <style name="CheckBox" parent="@android:style/Widget.CompoundButton.CheckBox">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">?attr/colorPrimaryText</item>
    </style>
    <style name="RadioButton" parent="@android:style/Widget.CompoundButton.RadioButton">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">?attr/colorPrimaryText</item>
        <item name="android:paddingRight">8dp</item>
    </style>
    <style name="TitleTextAppearance" parent="android:TextAppearance">
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/colorPrimaryText</item>
    </style>
    <style name="Toolbar" parent="@android:style/Widget.Toolbar">
        <item name="android:background">?attr/colorPrimary</item>
        <item name="titleTextColor">#ffffff</item>
        <item name="titleTextAppearance">@style/TitleTextAppearance</item>
    </style>
    <style name="BaseButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">42dp</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
        <item name="android:textSize">16sp</item>
        <item name="android:lines">1</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingLeft">24dp</item>
        <item name="android:paddingRight">24dp</item>
        <item name="android:textAllCaps">false</item>
    </style>
    <style name="ButtonNeutral" parent="BaseButton">
        <item name="android:background">@drawable/button_neutral</item>
        <item name="android:textColor">?attr/colorAccent</item>
    </style>
    <style name="ButtonPositive" parent="BaseButton">
        <item name="android:background">@drawable/button_positive</item>
        <item name="android:textColor">#ffffff</item>
    </style>
    <style name="BaseImageButton">
        <item name="android:layout_width">42dp</item>
        <item name="android:layout_height">42dp</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
        <item name="android:gravity">center</item>
        <item name="android:scaleType">centerInside</item>
        <item name="android:background">?selectableItemBackgroundBorderless</item>
        <item name="android:padding">4dp</item>
    </style>
    <style name="ToolButton" parent="BaseImageButton">
        <item name="android:layout_marginLeft">2dp</item>
        <item name="android:layout_marginRight">2dp</item>
        <item name="android:tint">?attr/colorPrimaryVariant</item>
    </style>
    <style name="ListMenuButton" parent="BaseImageButton">
        <item name="android:layout_width">34dp</item>
        <item name="android:layout_height">34dp</item>
        <item name="android:tint">?attr/colorPrimaryVariant</item>
        <item name="android:layout_marginLeft">2dp</item>
        <item name="android:layout_marginRight">2dp</item>
    </style>
    <style name="VerticalLine">
        <item name="android:layout_width">2dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:background">?attr/colorPrimaryVariant</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:layout_marginBottom">2dp</item>
        <item name="android:layout_marginLeft">8dp</item>
        <item name="android:layout_marginRight">8dp</item>
    </style>
    <style name="HorizontalLine">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">2dp</item>
        <item name="android:background">?attr/colorPrimaryVariant</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:layout_marginBottom">8dp</item>
    </style>
    <style name="FieldSeparator">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:background">?attr/colorPrimaryVariant</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:layout_marginBottom">8dp</item>
    </style>
    <style name="FieldSet">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bordered_panel</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingLeft">8dp</item>
        <item name="android:paddingRight">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:paddingTop">16dp</item>
        <item name="android:layout_marginTop">10dp</item>
    </style>
    <style name="FieldSetLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">?attr/colorPrimarySurface</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingLeft">4dp</item>
        <item name="android:paddingRight">4dp</item>
        <item name="android:layout_marginLeft">8dp</item>
        <item name="android:textColor">?attr/colorPrimaryVariant</item>
    </style>
    <style name="TableHead">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">28dp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">#ffffff</item>
        <item name="android:paddingLeft">4dp</item>
        <item name="android:gravity">center_vertical</item>
    </style>
    <style name="TableHeadRightLine">
        <item name="android:layout_width">1dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:background">#0278b8</item>
    </style>
    <style name="TableHeadBottomLine">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:background">#0278b8</item>
    </style>
    <style name="TableBodyRightLine">
        <item name="android:layout_width">1dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:background">?attr/colorControlNormal</item>
    </style>
    <style name="HelpButton">
        <item name="android:layout_width">22dp</item>
        <item name="android:layout_height">22dp</item>
        <item name="android:layout_marginLeft">4dp</item>
        <item name="android:src">@drawable/icon_help</item>
        <item name="tint">#e0e0e0</item>
    </style>
    <style name="Toolbox">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:background">?attr/toolboxBackground</item>
        <item name="android:paddingTop">2dp</item>
        <item name="android:paddingBottom">2dp</item>
        <item name="android:paddingLeft">8dp</item>
        <item name="android:paddingRight">8dp</item>
    </style>
    <style name="LeftSideButton">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">36dp</item>
        <item name="tint">?attr/colorPrimaryVariant</item>
        <item name="android:background">@drawable/left_side_button</item>
        <item name="android:padding">6dp</item>
    </style>
    <style name="RightSideButton">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">36dp</item>
        <item name="tint">?attr/colorPrimaryVariant</item>
        <item name="android:background">@drawable/right_side_button</item>
        <item name="android:padding">6dp</item>
    </style>
</resources>
