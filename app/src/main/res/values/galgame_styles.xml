<?xml version="1.0" encoding="utf-8"?>
<!--
  GalgameShell 设计系统：组件样式（R1）。
  自有屏统一弃用上游 FieldSet 范式，改用语义 token（?attr）+ 圆角卡。
  所有颜色一律 ?attr 引用主题 token，禁硬编码。
-->
<resources>
    <!-- 顶部品牌工具栏（替代上游 Toolbar 范式） -->
    <style name="GalToolbar" parent="@android:style/Widget.Toolbar">
        <item name="android:background">?attr/colorPrimary</item>
        <item name="android:minHeight">?attr/actionBarSize</item>
        <item name="titleTextColor">?attr/colorOnAccent</item>
        <item name="android:titleTextAppearance">@style/GalTextTitle</item>
    </style>

    <!-- 分区标题（小号、accent 色、字距收紧） -->
    <style name="GalSectionHeader">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/colorAccent</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:paddingTop">@dimen/gal_space_4</item>
        <item name="android:paddingBottom">@dimen/gal_space_2</item>
        <item name="android:paddingStart">@dimen/gal_space_2</item>
    </style>

    <!-- 圆角卡（主题感知：填充=colorSecondarySurface，描边=colorSecondaryVariant；?attr 在活动上下文可靠） -->
    <style name="GalCard">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/galgame_card_bg</item>
        <item name="android:padding">@dimen/gal_space_4</item>
    </style>

    <!-- 设置行容器（标题+说明+控件横向排布） -->
    <style name="GalSettingRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:paddingStart">@dimen/gal_space_4</item>
        <item name="android:paddingEnd">@dimen/gal_space_4</item>
    </style>

    <!-- 主操作按钮（复用品牌紫 button_positive，文字转 on_accent） -->
    <style name="GalPrimaryButton" parent="@style/BaseButton">
        <item name="android:background">@drawable/button_positive</item>
        <item name="android:textColor">?attr/colorOnAccent</item>
    </style>

    <!-- 标签 chip（pill，填充=colorSurfaceVariant，文字=colorAccent） -->
    <style name="GalChip">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/galgame_chip_pill</item>
        <item name="android:textColor">?attr/colorAccent</item>
        <item name="android:textSize">12sp</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">@dimen/gal_space_3</item>
        <item name="android:paddingEnd">@dimen/gal_space_3</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
    </style>

    <!-- 空态容器（图标+文案居中） -->
    <style name="GalEmptyState">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center</item>
        <item name="android:padding">@dimen/gal_space_8</item>
    </style>

    <!-- 底部导航（4 Tab，背景=colorSecondarySurface；R2 精细化 item 色调） -->
    <style name="GalBottomNav">
        <item name="android:background">?attr/colorSecondarySurface</item>
        <item name="android:elevation">@dimen/gal_space_1</item>
    </style>

    <!-- ===== Swiss grid (04) 组件样式：黑白纸面、1dp 黑线、零圆角、单点红 ===== -->
    <style name="SwissLabel">
        <item name="android:textSize">9sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.18</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/swiss_ink</item>
    </style>

    <style name="SwissMeta">
        <item name="android:textSize">9sp</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/swiss_muted</item>
    </style>

    <style name="SwissTitle">
        <item name="android:textSize">26sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:textColor">@color/swiss_ink</item>
    </style>

    <style name="SwissSubtitle">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:textColor">@color/swiss_ink</item>
    </style>

    <style name="SwissRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:background">@drawable/swiss_row_line</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="SwissRowTitle">
        <item name="android:textSize">13.5sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/swiss_ink</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="SwissRowMeta">
        <item name="android:textSize">9sp</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/swiss_muted</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="SwissButtonSolid">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:background">@drawable/swiss_button_solid</item>
        <item name="android:textColor">@color/swiss_paper</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.18</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:gravity">center</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:paddingStart">0dp</item>
        <item name="android:paddingEnd">0dp</item>
    </style>

    <style name="SwissButtonOutline" parent="SwissButtonSolid">
        <item name="android:background">@drawable/swiss_button_outline</item>
        <item name="android:textColor">@color/swiss_ink</item>
    </style>

    <style name="SwissTag">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/swiss_tag_line</item>
        <item name="android:paddingStart">6dp</item>
        <item name="android:paddingEnd">6dp</item>
        <item name="android:paddingTop">2dp</item>
        <item name="android:paddingBottom">2dp</item>
        <item name="android:textSize">9sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/swiss_muted</item>
    </style>

    <!-- 旧设置页重排后用的方框控件（零圆角、1dp 黑线） -->
    <style name="SwissSpinner">
        <item name="android:layout_width">160dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:background">@drawable/swiss_spinner_bg</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:textColor">@color/swiss_ink</item>
        <item name="android:textSize">13sp</item>
        <item name="android:popupBackground">@color/swiss_paper</item>
    </style>

    <style name="SwissToolbox">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:background">@drawable/swiss_toolbox_bg</item>
    </style>

    <style name="SwissIconButton">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:background">?android:attr/selectableItemBackground</item>
        <item name="android:padding">10dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:tint">@color/swiss_ink</item>
    </style>

    <style name="SwissCheck">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/swiss_ink</item>
        <item name="android:buttonTint">@color/swiss_ink</item>
    </style>

    <style name="SwissRadio">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/swiss_ink</item>
        <item name="android:buttonTint">@color/swiss_ink</item>
        <item name="android:paddingEnd">24dp</item>
    </style>

    <style name="SwissEdit">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:background">@drawable/swiss_fieldset</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/swiss_ink</item>
        <item name="android:textColorHint">@color/swiss_muted</item>
    </style>

    <style name="SwissConfirmBar">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:background">@color/swiss_ink</item>
        <item name="android:textColor">@color/swiss_paper</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.18</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:gravity">center</item>
    </style>

    <!-- 系统弹窗：纸面 + 1dp 黑框 + 黑色大写按钮（AppCompat 与 framework 两套） -->
    <style name="SwissDialogButton" parent="Widget.AppCompat.Button.ButtonBar.AlertDialog">
        <item name="android:textColor">@color/swiss_ink</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="SwissAlertDialog" parent="Theme.AppCompat.Light.Dialog.Alert">
        <item name="colorAccent">@color/swiss_ink</item>
        <item name="android:textColorPrimary">@color/swiss_ink</item>
        <item name="android:windowBackground">@drawable/swiss_dialog_bg</item>
        <item name="buttonBarPositiveButtonStyle">@style/SwissDialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/SwissDialogButton</item>
        <item name="buttonBarNeutralButtonStyle">@style/SwissDialogButton</item>
    </style>

    <style name="SwissFrameworkDialogButton">
        <item name="android:textColor">@color/swiss_ink</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:background">?android:attr/selectableItemBackground</item>
        <item name="android:minWidth">64dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="SwissFrameworkAlertDialog" parent="android:Theme.Material.Light.Dialog.Alert">
        <item name="android:colorAccent">@color/swiss_ink</item>
        <item name="android:textColorPrimary">@color/swiss_ink</item>
        <item name="android:windowBackground">@drawable/swiss_dialog_bg</item>
        <item name="android:buttonBarPositiveButtonStyle">@style/SwissFrameworkDialogButton</item>
        <item name="android:buttonBarNegativeButtonStyle">@style/SwissFrameworkDialogButton</item>
        <item name="android:buttonBarNeutralButtonStyle">@style/SwissFrameworkDialogButton</item>
    </style>
</resources>

