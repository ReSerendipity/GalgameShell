<?xml version="1.0" encoding="utf-8"?>
<resources>
    <attr name="value" format="float" />
    <attr name="minValue" format="integer|float" />
    <attr name="maxValue" format="integer|float" />
    <attr name="step" format="integer|float" />
    <attr name="textSize" format="dimension" />
    <attr name="colorPrimaryText" format="color" />
    <attr name="colorSecondaryText" format="color" />
    <attr name="colorSecondarySurface" format="color" />
    <attr name="colorSurfaceVariant" format="color" />
    <attr name="colorHairline" format="color" />
    <attr name="colorTextDisabled" format="color" />
    <attr name="colorOnAccent" format="color" />
    <!-- GalgameShell 品牌 token（2026-10-05）：顶栏渐变 / chip 一组组件此前在布局与 drawable 里
         写死颜色，导致 GalgameMainThemeDark 换了 token 也不生效（暗色档下这些部件仍是亮色）。
         统一提到 attr，由 GalgameMainTheme / GalgameMainThemeDark 各给一套值。 -->
    <attr name="galgameBrandStart" format="color" />
    <attr name="galgameBrandEnd" format="color" />
    <attr name="galgameChipBackground" format="color" />
    <attr name="galgameChipText" format="color" />
    <attr name="colorOnAccentSubtle" format="color" />
    <attr name="galgameCoverPlaceholder" format="color" />
    <attr name="toolboxBackground" format="reference" />
    <attr name="preloaderBackground" format="reference" />
    <attr name="progressBarIndeterminateImage" format="reference" />
    <declare-styleable name="NumberPicker">
        <attr name="value" />
        <attr name="minValue" />
        <attr name="maxValue" />
        <attr name="step" />
        <attr name="textSize" />
    </declare-styleable>
    <declare-styleable name="SeekBar">
        <attr name="value" />
        <attr name="minValue" />
        <attr name="maxValue" />
        <attr name="step" />
        <attr name="suffix" format="string" />
        <attr name="textSize" />
    </declare-styleable>
</resources>