<?xml version="1.0" encoding="utf-8" standalone="no"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="com.winlator">
    <uses-feature
        android:glEsVersion="0x00020000"
        android:required="true" />

    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE"/>
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"/>
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"/>
    <!-- GalgameShell: Kirikiri 内置引擎需整库读写 /sdcard 游戏目录（Android 11+ 须 All-Files-Access，设置页手授） -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"/>
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS"/>
    <uses-permission android:name="android.permission.VIBRATE"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- GalgameShell: 让 Android 11+ 能看到原生播放器（B 路由唤起，P5） -->
    <queries>
        <package android:name="org.tvp.kirikiri2" />
        <package android:name="jp.ogapee.onscripter.release" />
        <package android:name="cyou.joiplay" />
        <package android:name="com.akira.tyranoemu" />
    </queries>

    <application
        android:icon="@mipmap/ic_launcher"
        android:appCategory="game"
        android:isGame="true"
        android:extractNativeLibs="true"
        android:allowAudioPlaybackCapture="true"
        android:label="@string/app_name">

        <!-- GalgameShell R2：旧抽屉壳保留但不再作为 launcher（GalgameMainActivity 接管启动入口） -->
        <activity android:name="com.winlator.MainActivity"
            android:theme="@style/GalgameMainTheme"
            android:exported="false"
            android:screenOrientation="sensor"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout|smallestScreenSize|density|navigation" />

        <!-- GalgameShell R2：新底部导航壳，启动即游戏库（游戏库/容器/工具/设置 4 Tab） -->
        <activity android:name="com.winlator.GalgameMainActivity"
            android:theme="@style/GalgameMainTheme"
            android:exported="true"
            android:screenOrientation="sensor"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout|smallestScreenSize|density|navigation">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <activity android:name="com.winlator.XServerDisplayActivity"
            android:exported="false"
            android:theme="@style/AppThemeFullscreenDark"
            android:supportsPictureInPicture="true"
            android:launchMode="singleTask"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout|smallestScreenSize|density|navigation"
            android:screenOrientation="sensorLandscape" />

        <activity android:name="com.winlator.ControlsEditorActivity"
            android:exported="false"
            android:theme="@style/AppThemeFullscreenDark"
            android:screenOrientation="sensorLandscape" />

        <activity android:name="com.winlator.ExternalControllerBindingsActivity"
            android:theme="@style/GalgameMainTheme"
            android:exported="false"
            android:screenOrientation="sensor" />

        <!-- GalgameShell 游戏库（全新 Activity，P1/P2/P4/P5 前端入口）；亮色主题 + v29 关闭 Force Dark（系统深色模式强转暗色的根因） -->
        <activity android:name="com.winlator.galgame.ui.GalgameLibraryActivity"
            android:theme="@style/GalgameLibraryTheme"
            android:exported="false"
            android:screenOrientation="sensor"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout|smallestScreenSize|density|navigation" />

        <!-- GalgameShell：Kirikiroid2 内置引擎宿主（引擎运行时随本 APK 打包，不唤起任何第三方 App） -->
        <!-- 引擎自身 Activity：libgame.so 的 JNI 按硬编码类名 org/tvp/kirikiri2/KR2Activity 绑定，包不得改名 -->
        <activity android:name="org.tvp.kirikiri2.KR2Activity"
            android:theme="@style/GalgameKrkrTheme"
            android:screenOrientation="sensorLandscape"
            android:configChanges="keyboardHidden|screenSize|density"
            android:windowSoftInputMode="adjustResize"
            android:exported="false" />

        <!--
          cocos2dx 的 Cocos2dxActivity 在 onCreate 里读 meta-data android.app.lib_name 并
          System.loadLibrary(name)。libgame.so 只显式 load ffmpeg/SDL2，主库 game 必须靠这里加载；
          缺失会在运行期直接 UnsatisfiedLinkError（上游 Kirikiroid2 1.4.1 同样靠这条注入）。
        -->
        <meta-data
            android:name="android.app.lib_name"
            android:value="game" />

        <!-- Needed for keep the container alive when in background or the device is locked. -->
        <service
            android:name="com.winlator.services.ForegroundService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback"
            android:stopWithTask="false">
        </service>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.winlator.FileProvider"
            android:exported="false"
            android:grantUriPermissions="true">

            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"/>
        </provider>
    </application>
</manifest>
