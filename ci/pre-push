#!/bin/sh
# ci/pre-push — 推送前类型门禁（本地版 galgame-compile）
#
# 与 .github/workflows/ci.yml 的 galgame-compile job 同口径：用 ci/stubs 对
# com.winlator.galgame 整树 + 热点入口清单（子树外的显式文件列表）做 javac -Xlint:all。
# 目的是把 CI 红灯提前到本地几秒内暴露——历史上两次 CI 失败都是「新代码用了桩里
# 没有的 API」（Log.w 三参重载 / Context.getFilesDir / ValueAnimator.cancel），
# 本地无门禁时只能等 CI 才发现。
#
# 本文件是版本库内的唯一来源。启用（一次性，在仓库根目录执行）：
#     POSIX / Git-Bash:    cp ci/pre-push .git/hooks/pre-push && chmod +x .git/hooks/pre-push
#     Windows PowerShell:  Copy-Item ci/pre-push .git/hooks/pre-push
#                          （无需 chmod；Git for Windows 用自带 sh.exe 执行本钩子，
#                            宿主 shell 是 pwsh 也能装，不必另装 bash 或开 WSL）
# 不装钩子时的手动等价调用（PowerShell 版等价 javac 序列），以及「未装钩子 / 缺 javac
# 放行时由 CI 的 push、pull_request 触发兜底」的口径，见根 README
# 「本地门禁：推送前类型检查（pre-push）」一节与 ci/README.md。
#
# 无 javac 时优雅跳过并提示（不阻断），避免把钩子变成环境依赖门禁。
set -e
cd "$(git rev-parse --show-toplevel)" || exit 1

# 落地路径上的逐提交签署校验。docs/CONTRIBUTING.md 要求所有提交带 Signed-off-by，而 CI 侧的
# 执行体只在 pull_request 事件运行；本仓提交经直推 main 落地，所以把关放在这里。
# 钩子被 git 以 <remote> <url> <local-ref> <local-sha> <remote-ref> <remote-sha> 调用；
# 手动 `sh ci/pre-push` 时无参数，脚本自动回落到 @{upstream}..HEAD。
echo "[pre-push] DCO 逐提交签署校验"
if ! REMOTE_SHA="${6:-}" LOCAL_SHA="${4:-}" bash ci/check-dco.sh; then
    echo "[pre-push] ✗ 签署校验未通过，已阻止推送（补签署：git commit -s）。" >&2
    exit 1
fi

JAVAC=""
if command -v javac >/dev/null 2>&1; then
    JAVAC="javac"
elif [ -n "$JAVA_HOME" ] && [ -x "$JAVA_HOME/bin/javac" ]; then
    JAVAC="$JAVA_HOME/bin/javac"
fi

if [ -z "$JAVAC" ]; then
    echo "[pre-push] 未找到 javac（PATH 与 JAVA_HOME 都没有），跳过类型门禁；CI 仍会检查" >&2
    exit 0
fi

# 输出目录放在 .git/ 下的相对路径：既不会入库，也避免 Windows 盘符绝对路径
# 在 MSYS 环境下触发删除限制。
OUT=".git/pre-push-out.$$"
mkdir -p "$OUT/stubs" "$OUT/check"
trap 'rm -rf "$OUT"' EXIT INT TERM

echo "[pre-push] 类型门禁：com.winlator.galgame（对 ci/stubs）"
if ! "$JAVAC" -d "$OUT/stubs" $(find ci/stubs -name '*.java'); then
    echo "[pre-push] ✗ ci/stubs 自身编译失败，已阻止推送" >&2
    exit 1
fi
if ! "$JAVAC" -Xlint:all -cp "$OUT/stubs" -d "$OUT/check" $(find app/src/main/java/com/winlator/galgame -name '*.java'); then
    echo "[pre-push] ✗ 类型门禁未通过，已阻止推送。" >&2
    echo "           新代码用到了 ci/stubs 里没有的 API —— 按 ci/README.md 补桩后重试。" >&2
    exit 1
fi

# 热点入口清单：唯一来源 ci/hotspot-entries.txt（与 ci.yml 共用同一份，勿在此复制文件列表）。
HOT="$(grep -vE '^[[:space:]]*(#|$)' ci/hotspot-entries.txt || true)"
if [ -z "$HOT" ]; then
    echo "[pre-push] ✗ ci/hotspot-entries.txt 没有有效条目，热点门禁无法执行。" >&2
    exit 1
fi
echo "[pre-push] 类型门禁：热点入口清单（对 ci/stubs + 已编译的 galgame 全树）"
if ! "$JAVAC" -Xlint:all -cp "$OUT/stubs:$OUT/check" -d "$OUT/hot" $HOT; then
    echo "[pre-push] ✗ 热点入口类类型门禁未通过，已阻止推送。" >&2
    echo "           新代码用到了 ci/stubs 里没有的 API —— 按 ci/README.md 补桩后重试。" >&2
    exit 1
fi
echo "[pre-push] ✓ 类型门禁通过（ci/stubs + com.winlator.galgame 全树 + 热点清单，-Xlint:all）"
